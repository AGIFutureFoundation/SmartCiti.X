+  dv.setUint32(12, enc.length + jpad, true); dv.setUint32(16, TYPE_JSON, true);
+  out.set(enc, 20); out.fill(0x20, 20 + enc.length, 20 + enc.length + jpad);
+  const bo = 20 + enc.length + jpad;
+  dv.setUint32(bo, bin.length + bpad, true); dv.setUint32(bo + 4, TYPE_BIN, true);
